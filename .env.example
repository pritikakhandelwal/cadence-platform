# Copy to .env (git-ignored) and fill in for local development.
# apps/api and apps/worker both read these via os.getenv.

# Postgres (docker-compose up postgres). Omit / leave unset to fall back
# to a local SQLite file, which is fine for quick manual testing.
DATABASE_URL=postgresql+psycopg2://cadence:cadence@localhost:5432/cadence

# Redis (docker-compose up redis), used by apps/worker's job queue.
REDIS_URL=redis://localhost:6379

# Where per-analysis upload/output files live. Defaults to apps/api/runtime
# if unset.
CADENCE_RUNTIME_DIR=
