# Copy to .env (git-ignored) and fill in for local development.
# apps/api and apps/worker both read these via os.getenv.

# Postgres (docker-compose up postgres). Omit / leave unset to fall back
# to a local SQLite file, which is fine for quick manual testing.
DATABASE_URL=postgresql+psycopg2://cadence:cadence@localhost:5432/cadence

# Redis (docker-compose up redis). apps/api enqueues jobs onto it,
# apps/worker consumes them.
REDIS_URL=redis://localhost:6379

# Where per-analysis upload/output files live. Both apps/api (writes
# uploads) and apps/worker (reads them for detection/pose) need to
# agree on this -- defaults to <repo_root>/runtime if unset, which
# already keeps them in sync for local dev without setting this.
CADENCE_RUNTIME_DIR=
